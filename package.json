{
    "name": "peek-a-boo",
    "version": "1.3.3",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "npm run test:unit",
        "test:unit": "vitest run --config tests/vitest.config.ts",
        "test:e2e": "playwright test --config tests/playwright.config.ts",
        "test:e2e:ui": "playwright test --config tests/playwright.config.ts --ui",
        "docker:test": "docker compose -f docker-compose.yml -f docker-compose.test.yml up -d --build",
        "docker:test:down": "docker compose -f docker-compose.yml -f docker-compose.test.yml down -v",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,mjs,mts}": "eslint --fix",
        "*.{json,css,md}": "prettier --write"
    },
    "dependencies": {
        "@mui/icons-material": "^7.3.5",
        "@system-b15/hive-core": "^0.1.1",
        "jsonwebtoken": "^9.0.2",
        "ldapjs": "^3.0.7",
        "next": "^16.0.1",
        "notistack": "^3.0.2",
        "postgres": "^3.4.4",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-error-boundary": "^6.0.0",
        "react-vnc": "^3.0.8",
        "stylis": "^4.3.6",
        "stylis-plugin-rtl": "^2.1.1"
    },
    "devDependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@eslint/eslintrc": "^3",
        "@mui/material": "^7.0.1",
        "@playwright/test": "^1.61.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/postcss": "^4",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/ldapjs": "^3.0.6",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "baseline-browser-mapping": "^2.9.18",
        "eslint": "^9",
        "eslint-config-next": "^16.2.10",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-perfectionist": "^5.10.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-unicorn": "^64.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8",
        "prettier": "^3.9.5",
        "tailwindcss": "^4",
        "typescript": "^5",
        "typescript-eslint": "^8.64.0",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.10"
    }
}
