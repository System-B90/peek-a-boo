{
    "name": "peek-a-boo",
    "version": "1.3.3",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "npm run test:unit",
        "test:unit": "vitest run --config tests/vitest.config.ts",
        "test:e2e": "playwright test --config tests/playwright.config.ts",
        "test:e2e:ui": "playwright test --config tests/playwright.config.ts --ui",
        "docker:dev": "docker compose --env-file .env -f deploy/docker-compose.yml -f deploy/docker-compose.dev.yml up --build --watch --no-attach proxy --no-attach vnc-bridge",
        "docker:prod": "docker compose --env-file .env -f deploy/docker-compose.yml up -d",
        "docker:down": "docker compose --env-file .env -f deploy/docker-compose.yml -f deploy/docker-compose.dev.yml down",
        "docker:nuke": "docker compose --env-file .env -f deploy/docker-compose.yml -f deploy/docker-compose.dev.yml down -v --rmi local",
        "docker:test": "docker compose -f docker-compose.yml -f docker-compose.test.yml up -d --build",
        "docker:test:down": "docker compose -f docker-compose.yml -f docker-compose.test.yml down -v",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,mjs,mts}": "eslint --fix",
        "*.{json,css,md}": "prettier --write"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^7.3.11",
        "@mui/material": "^7.3.11",
        "@system-b90/command-palette": "^0.1.0",
        "@system-b90/hive-core": "^0.3.0",
        "@system-b90/hive-nextauth": "^0.1.4",
        "jsonwebtoken": "^9.0.3",
        "next": "^16.3.6",
        "next-auth": "^4.24.15",
        "notistack": "^3.0.2",
        "postgres": "^3.4.9",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-error-boundary": "^6.1.6",
        "react-vnc": "^3.2.0",
        "stylis": "^4.4.0",
        "stylis-plugin-rtl": "^2.1.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@playwright/test": "^1.63.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@system-b90/test-kit": "^0.1.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^24.19.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "baseline-browser-mapping": "^2.11.26",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.3.6",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-perfectionist": "^5.12.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-unicorn": "^65.0.1",
        "eslint-plugin-unused-imports": "^4.4.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0",
        "typescript-eslint": "^8.70.1",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^5.0.2"
    }
}
